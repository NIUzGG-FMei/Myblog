---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout
    title="模型雷达"
    description="CodexRadar DeepSWE 众测数据：各模型 IQ 与推理档位代码修复任务通过率"
>
    <div class="onload-animation">
        <div class="card-base rounded-(--radius-large) p-6 mb-6">
            <div class="flex items-center gap-3 mb-2">
                <Icon is:inline name="material-symbols:radar" class="text-3xl text-(--primary)" />
                <div>
                    <h2 class="text-xl font-bold text-90">模型智力雷达</h2>
                    <p class="text-sm text-75">
                        数据来源：CodexRadar 分布式众测 · DeepSWE 代码修复基准，约每 30 分钟刷新一次
                    </p>
                </div>
            </div>

            <div id="radar-root" class="text-75 text-sm py-8 text-center">
                <div class="flex items-center justify-center gap-2">
                    <Icon is:inline name="material-symbols:sync-rounded" class="animate-spin" />
                    <span>正在加载数据…</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        interface RadarTier {
            effort: string;
            pass_rate: number;
            cells_passed: number;
            cells: number;
            graded: number;
        }
        interface RadarGroup {
            model: string;
            iq?: number;
            tiers: RadarTier[];
        }
        interface RadarPoint {
            ts: string;
            score: number;
        }
        interface RadarData {
            groups: RadarGroup[];
            iq: Record<string, RadarPoint[]>;
            generated_at: string;
            source: string;
            error?: string;
        }

        (function () {
            const root = document.getElementById("radar-root") as HTMLElement;

            const effortLabel = (e: string) => {
                if (!e) return "";
                const map: Record<string, string> = { low: "低", high: "高", xhigh: "极高" };
                return map[e] || e;
            };

            function renderTiers(group: RadarGroup): string {
                const rows = group.tiers
                    .map(
                        (t) => `
                        <tr class="border-t border-(--line-divider)/40">
                            <td class="py-2 px-2 font-mono text-sm">${effortLabel(t.effort) || t.effort}</td>
                            <td class="py-2 px-2 text-right font-mono text-sm">${(t.pass_rate * 100).toFixed(1)}%</td>
                            <td class="py-2 px-2 text-right text-sm">${t.cells_passed}/${t.cells}</td>
                            <td class="py-2 px-2 text-right text-sm text-60">${t.graded}</td>
                        </tr>`,
                    )
                    .join("");
                return `
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="text-xs text-60">
                                    <th class="py-1 px-2 font-medium">档位</th>
                                    <th class="py-1 px-2 text-right font-medium">通过率</th>
                                    <th class="py-1 px-2 text-right font-medium">通过任务</th>
                                    <th class="py-1 px-2 text-right font-medium">已评测</th>
                                </tr>
                            </thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>`;
            }

            function renderChart(points: RadarPoint[] | undefined): string {
                if (!points || points.length < 2) return "";
                const W = 100, H = 40, PAD = 3;
                const scores = points.map((p) => p.score);
                const min = Math.min(...scores), max = Math.max(...scores);
                const range = max - min || 1;
                const coords = points.map((p: RadarPoint, i: number) => {
                    const x = PAD + (i / (points.length - 1)) * (W - PAD * 2);
                    const y = H - PAD - ((p.score - min) / range) * (H - PAD * 2);
                    return `${x.toFixed(2)},${y.toFixed(2)}`;
                });
                const primary = getComputedStyle(document.documentElement).getPropertyValue("--primary").trim() || "#4f8cff";
                return `
                    <div class="mt-4 pt-3 border-t border-(--line-divider)/40">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs text-75">IQ 历史曲线（最新 ${points[points.length - 1].score.toFixed(1)}）</span>
                            <span class="text-xs text-60">${min.toFixed(1)} ~ ${max.toFixed(1)}</span>
                        </div>
                        <svg class="w-full" viewBox="0 0 100 40" preserveAspectRatio="none" style="height: 8rem;">
                            <polyline points="${coords.join(" ")}" fill="none" stroke="${primary}" stroke-width="0.6" stroke-linejoin="round"/>
                            <circle cx="${coords[coords.length - 1].split(",")[0]}" cy="${coords[coords.length - 1].split(",")[1]}" r="1.2" fill="${primary}"/>
                        </svg>
                    </div>`;
            }

            function renderGroups(data: RadarData) {
                const cards = data.groups
                    .map((g, i) => `
                        <div class="card-base rounded-(--radius-large) mb-3 overflow-hidden group-card" data-idx="${i}">
                            <button class="w-full flex items-center justify-between gap-3 px-5 py-4 text-left hover:bg-(--primary)/5 transition-colors" aria-expanded="false">
                                <span class="flex items-center gap-3 min-w-0">
                                    <span class="font-mono font-semibold text-90 truncate">${g.model}</span>
                                    <span class="text-xs text-60 shrink-0">${g.tiers.length} 个档位</span>
                                </span>
                                <span class="flex items-center gap-3 shrink-0">
                                    <span class="font-mono font-bold text-lg text-(--primary)">${g.iq !== undefined ? g.iq.toFixed(1) : "—"}</span>
                                    <Icon is:inline name="material-symbols:expand-more-rounded" class="chevron text-xl text-60 transition-transform duration-300" />
                                </span>
                            </button>
                            <div class="tiers-wrap grid transition-all duration-300 grid-rows-[0fr] opacity-0">
                                <div class="overflow-hidden min-h-0">
                                    <div class="px-5 pb-4">
                                        <div class="tiers-body"></div>
                                    </div>
                                </div>
                            </div>
                        </div>`)
                    .join("");
                root.innerHTML = `${cards}
                    <p class="text-xs text-60 mt-3">
                        数据来源：<a class="underline" href="${data.source}" target="_blank" rel="noopener">CodexRadar</a> ·
                        更新于 ${new Date(data.generated_at).toLocaleString("zh-CN")} · 点击卡片展开各档位数据
                    </p>`;

                root.querySelectorAll<HTMLElement>(".group-card").forEach((card) => {
                    const idx = Number(card.dataset.idx);
                    const group = data.groups[idx];
                    const body = card.querySelector(".tiers-body") as HTMLElement;
                    body.innerHTML = `${renderTiers(group)}${renderChart(data.iq[group.model])}`;

                    const btn = card.querySelector("button") as HTMLButtonElement;
                    const chevron = card.querySelector(".chevron") as HTMLElement;
                    btn.addEventListener("click", () => {
                        const wrap = card.querySelector(".tiers-wrap") as HTMLElement;
                        const isOpen = wrap.classList.contains("opacity-100");
                        root.querySelectorAll<HTMLElement>(".tiers-wrap.opacity-100").forEach((w) => {
                            w.classList.remove("opacity-100");
                            w.classList.add("opacity-0");
                            w.style.gridTemplateRows = "0fr";
                            const b = w.parentElement?.parentElement?.querySelector("button");
                            if (b) b.setAttribute("aria-expanded", "false");
                            const ch = w.parentElement?.parentElement?.querySelector(".chevron") as HTMLElement | null;
                            if (ch) ch.style.transform = "";
                        });
                        if (!isOpen) {
                            wrap.classList.remove("opacity-0");
                            wrap.classList.add("opacity-100");
                            wrap.style.gridTemplateRows = "1fr";
                            btn.setAttribute("aria-expanded", "true");
                            chevron.style.transform = "rotate(180deg)";
                        }
                    });
                });
            }

            fetch("/api/codexradar/")
                .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
                .then((data: RadarData) => {
                    if (data.error) throw new Error(data.error);
                    if (!data.groups || !data.groups.length) throw new Error("数据为空");
                    root.classList.remove("py-8", "text-center");
                    renderGroups(data);
                })
                .catch((e: Error) => {
                    root.innerHTML = `
                        <div class="text-(--danger-color, #f87171)">
                            <p class="mb-1">加载失败：${e.message || "未知错误"}</p>
                            <button class="mt-2 px-4 py-1.5 bg-(--primary) text-white rounded-lg text-sm" onclick="location.reload()">重试</button>
                        </div>`;
                });
        })();
    </script>
</MainGridLayout>
