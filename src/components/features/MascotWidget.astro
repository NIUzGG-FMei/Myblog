---
import { Icon } from "astro-icon/components";
import type { MascotConfig } from "@/types/pioConfig";
import { url } from "@/utils/url-utils";

interface Props {
	config: MascotConfig;
}

const { config } = Astro.props;

const imageUrl = url(config.image);
const allImages = [imageUrl, ...(config.images ?? []).map((p) => url(p))].filter(
	(value, index, self) => self.indexOf(value) === index,
);
const size = config.size ?? 110;
const corner = config.position?.corner ?? "bottom-right";
const offsetX = config.position?.offsetX ?? 16;
const offsetY = config.position?.offsetY ?? 96;
const zIndex = config.zIndex ?? 990;
const canvasZIndex = zIndex - 10;
const hideOnMobile = config.hideOnMobile ?? false;
const drawLabel = config.menu?.drawLabel ?? "随意画画";
const clearLabel = config.menu?.clearLabel ?? "清除笔迹";
const randomEnabled = config.random?.enabled ?? true;
const randomInterval = config.random?.interval ?? 60000;

const anchorStyle =
	corner === "bottom-left"
		? `left: ${offsetX}px; bottom: ${offsetY}px;`
		: `right: ${offsetX}px; bottom: ${offsetY}px;`;
---

{
	config.enable && (
		<>
			<canvas
				id="mascot-draw-canvas"
				class="mascot-canvas"
				style={`z-index: ${canvasZIndex};`}
				aria-hidden="true"
			>
			</canvas>

			<div
				id="mascot-container"
				class:list={["mascot-container", { "mascot-hide-on-mobile": hideOnMobile }]}
				style={`z-index: ${zIndex}; ${anchorStyle}`}
				data-images={JSON.stringify(allImages)}
				data-random-enabled={randomEnabled}
				data-random-interval={randomInterval}
				data-size={size}
			>
				<div id="mascot-menu" class="mascot-menu hidden">
					<button
						id="mascot-menu-lock"
						type="button"
						class="mascot-menu-icon-btn"
						title="锁定/解锁形象"
					>
						<span id="mascot-menu-icon-lock">
							<Icon is:inline name="material-symbols:lock" />
						</span>
						<span id="mascot-menu-icon-unlock" class="hidden">
							<Icon is:inline name="material-symbols:lock-open-rounded" />
						</span>
					</button>
					<button
						id="mascot-menu-refresh"
						type="button"
						class="mascot-menu-icon-btn"
						title="刷新形象"
					>
						<Icon is:inline name="material-symbols:sync-rounded" />
					</button>
					<button
						id="mascot-menu-btn"
						type="button"
						class="mascot-menu-btn"
						data-draw-label={drawLabel}
						data-clear-label={clearLabel}
					>
						<span id="mascot-menu-label">{drawLabel}</span>
					</button>
				</div>
				<img
					id="mascot-img"
					class="mascot-img"
					src={imageUrl}
					alt="看板娘"
					draggable="false"
					width={size}
					loading="eager"
					fetchpriority="low"
				/>
			</div>
		</>
	)
}

<style>
	.mascot-canvas {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		display: none;
		pointer-events: none;
		touch-action: none;
		cursor: crosshair;
	}

	.mascot-container {
		position: fixed;
		pointer-events: auto;
		user-select: none;
		-webkit-user-select: none;
	}

	.mascot-img {
		display: block;
		cursor: grab;
		touch-action: none;
		-webkit-user-drag: none;
		user-drag: none;
	}

	.mascot-container.mascot-dragging .mascot-img {
		cursor: grabbing;
	}

	.mascot-menu {
		position: absolute;
		right: 0;
		bottom: calc(100% + 8px);
		pointer-events: auto;
		white-space: nowrap;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	/* 覆盖 Tailwind 的 .hidden（组件内 display:flex 优先级更高，需显式声明） */
	.mascot-menu.hidden {
		display: none;
	}

	.mascot-menu-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 9999px;
		border: 1px solid var(--line-divider, rgb(0 0 0 / 10%));
		background: var(--card-bg, #ffffff);
		color: var(--content);
		font-size: 1.1rem;
		cursor: pointer;
		box-shadow: 0 4px 16px rgb(0 0 0 / 12%);
		transition: transform 0.15s ease, background-color 0.15s ease;
	}

	.mascot-menu-icon-btn:hover {
		transform: translateY(-1px);
	}

	.mascot-menu-icon-btn.mascot-active {
		background: var(--primary, rgb(245 158 11 / 90%));
		color: #ffffff;
		border-color: transparent;
	}

	.mascot-menu-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.9rem;
		border-radius: 9999px;
		border: 1px solid var(--line-divider, rgb(0 0 0 / 10%));
		background: var(--card-bg, #ffffff);
		color: var(--content);
		font-size: 0.85rem;
		line-height: 1.2;
		cursor: pointer;
		box-shadow: 0 4px 16px rgb(0 0 0 / 12%);
		transition: transform 0.15s ease, background-color 0.15s ease;
	}

	.mascot-menu-btn:hover {
		transform: translateY(-1px);
	}

	.mascot-menu-btn.mascot-active {
		background: var(--primary, rgb(245 158 11 / 90%));
		color: #ffffff;
		border-color: transparent;
	}

	@media (max-width: 768px) {
		.mascot-hide-on-mobile {
			display: none !important;
		}
	}
</style>

<script>
	function initMascot() {
		const container = document.getElementById("mascot-container");
		const img = document.getElementById("mascot-img") as HTMLImageElement | null;
		const menu = document.getElementById("mascot-menu");
		const btn = document.getElementById("mascot-menu-btn");
		const label = document.getElementById("mascot-menu-label");
		const lockBtn = document.getElementById("mascot-menu-lock");
		const iconLock = document.getElementById("mascot-menu-icon-lock");
		const iconUnlock = document.getElementById("mascot-menu-icon-unlock");
		const refreshBtn = document.getElementById("mascot-menu-refresh");
		const canvas = document.getElementById("mascot-draw-canvas");

		if (
			!container ||
			!img ||
			!menu ||
			!btn ||
			!label ||
			!lockBtn ||
			!iconLock ||
			!iconUnlock ||
			!refreshBtn ||
			!(canvas instanceof HTMLCanvasElement)
		) {
			return;
		}

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// 形象列表与随机配置
		const images = JSON.parse(container.dataset.images || "[]");
		const randomEnabled = container.dataset.randomEnabled === "true";
		const randomInterval =
			parseInt(container.dataset.randomInterval || "60000", 10) || 60000;
		const targetWidth = parseInt(container.dataset.size || "110", 10);
		// 以默认形象 naicongqishi（368x429）的展示面积为基准做等比缩放，保持“差不多大”
		const targetArea = targetWidth * Math.round((targetWidth * 429) / 368);

		let currentIndex = 0;
		let locked = false;
		let randomTimer: ReturnType<typeof setInterval> | null = null;

		// 图片等比缩放到目标面积（保持原始比例）
		const fitImg = () => {
			const w = img.naturalWidth;
			const h = img.naturalHeight;
			if (!w || !h) return;
			const scale = Math.sqrt(targetArea / (w * h));
			img.style.width = `${Math.round(w * scale)}px`;
			img.style.height = `${Math.round(h * scale)}px`;
		};
		img.addEventListener("load", fitImg);
		if (img.complete && img.naturalWidth > 0) fitImg();

		const pickRandomIndex = () => {
			if (images.length <= 1) return 0;
			let index;
			do {
				index = Math.floor(Math.random() * images.length);
			} while (index === currentIndex);
			return index;
		};

		const setMascot = (index: number) => {
			currentIndex = index;
			img.src = images[index];
		};

		const stopRandomTimer = () => {
			if (randomTimer) {
				clearInterval(randomTimer);
				randomTimer = null;
			}
		};

		const startRandomTimer = () => {
			stopRandomTimer();
			if (randomEnabled && !locked && images.length > 1) {
				randomTimer = setInterval(() => {
					setMascot(pickRandomIndex());
				}, randomInterval);
			}
		};

		const setLocked = (on: boolean) => {
			locked = on;
			lockBtn.classList.toggle("mascot-active", on);
			iconLock.classList.toggle("hidden", on);
			iconUnlock.classList.toggle("hidden", !on);
			if (on) {
				stopRandomTimer();
			} else {
				startRandomTimer();
			}
		};

		let menuOpen = false;
		let drawing = false;
		let drag: {
			startX: number;
			startY: number;
			originX: number;
			originY: number;
			moved: boolean;
		} | null = null;
		const strokes: { points: number[][]; color: string; width: number }[] = [];
		let currentStroke: { points: number[][]; color: string; width: number } | null =
			null;

		const strokeColor = () => {
			const color = getComputedStyle(document.documentElement)
				.getPropertyValue("--primary")
				.trim();
			return color || "#f59e0b";
		};

		const paintStroke = (stroke: {
			points: number[][];
			color: string;
			width: number;
		}) => {
			if (stroke.points.length < 2) return;
			ctx.strokeStyle = stroke.color;
			ctx.lineWidth = stroke.width;
			ctx.lineCap = "round";
			ctx.lineJoin = "round";
			ctx.beginPath();
			ctx.moveTo(stroke.points[0][0], stroke.points[0][1]);
			for (let i = 1; i < stroke.points.length; i++) {
				ctx.lineTo(stroke.points[i][0], stroke.points[i][1]);
			}
			ctx.stroke();
		};

		const redraw = () => {
			ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
			for (const stroke of strokes) paintStroke(stroke);
		};

		const fitCanvas = () => {
			const dpr = window.devicePixelRatio || 1;
			canvas.width = Math.round(window.innerWidth * dpr);
			canvas.height = Math.round(window.innerHeight * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			redraw();
		};

		const setDrawing = (on: boolean) => {
			drawing = on;
			canvas.style.display = on ? "block" : "none";
			canvas.style.pointerEvents = on ? "auto" : "none";
			btn.classList.toggle("mascot-active", on);
			label.textContent = on
				? (btn.dataset.clearLabel || "清除笔迹")
				: (btn.dataset.drawLabel || "随意画画");
			if (!on) {
				strokes.length = 0;
				redraw();
			}
		};

		const openMenu = () => {
			menuOpen = true;
			menu.classList.remove("hidden");
			// 看板娘太靠上时菜单改为向下弹出，避免被顶出屏幕
			const rect = container.getBoundingClientRect();
			if (rect.top < 80) {
				menu.style.bottom = "auto";
				menu.style.top = "calc(100% + 8px)";
			} else {
				menu.style.top = "auto";
				menu.style.bottom = "calc(100% + 8px)";
			}
		};

		const closeMenu = () => {
			menuOpen = false;
			menu.classList.add("hidden");
		};

		// 锁定/解锁按钮
		lockBtn.addEventListener("click", () => {
			setLocked(!locked);
		});

		// 刷新按钮：无论锁定与否，手动随机更换形象
		refreshBtn.addEventListener("click", () => {
			setMascot(pickRandomIndex());
		});

		// 菜单按钮：切换画画模式，关掉时清除笔迹
		btn.addEventListener("click", () => {
			setDrawing(!drawing);
		});

		// 涂鸦画布
		canvas.addEventListener("pointerdown", (event) => {
			if (!drawing) return;
			currentStroke = {
				points: [[event.clientX, event.clientY]],
				color: strokeColor(),
				width: 4,
			};
			strokes.push(currentStroke);
			canvas.setPointerCapture(event.pointerId);
		});

		canvas.addEventListener("pointermove", (event) => {
			if (!drawing || !currentStroke) return;
			const points = currentStroke.points;
			const prev = points[points.length - 1];
			points.push([event.clientX, event.clientY]);
			ctx.strokeStyle = currentStroke.color;
			ctx.lineWidth = currentStroke.width;
			ctx.lineCap = "round";
			ctx.beginPath();
			ctx.moveTo(prev[0], prev[1]);
			ctx.lineTo(event.clientX, event.clientY);
			ctx.stroke();
		});

		const endStroke = () => {
			currentStroke = null;
		};
		canvas.addEventListener("pointerup", endStroke);
		canvas.addEventListener("pointercancel", endStroke);

		// 看板娘拖动
		img.addEventListener("pointerdown", (event) => {
			event.preventDefault();
			img.setPointerCapture(event.pointerId);
			// 从角锚定切换为坐标定位
			const rect = container.getBoundingClientRect();
			container.style.left = `${rect.left}px`;
			container.style.top = `${rect.top}px`;
			container.style.right = "auto";
			container.style.bottom = "auto";
			drag = {
				startX: event.clientX,
				startY: event.clientY,
				originX: rect.left,
				originY: rect.top,
				moved: false,
			};
		});

		img.addEventListener("pointermove", (event) => {
			if (!drag) return;
			const dx = event.clientX - drag.startX;
			const dy = event.clientY - drag.startY;
			if (!drag.moved && Math.hypot(dx, dy) < 4) return;
			drag.moved = true;
			container.classList.add("mascot-dragging");
			const rect = container.getBoundingClientRect();
			const x = Math.min(
				Math.max(drag.originX + dx, 0),
				window.innerWidth - rect.width,
			);
			const y = Math.min(
				Math.max(drag.originY + dy, 0),
				window.innerHeight - rect.height,
			);
			container.style.left = `${x}px`;
			container.style.top = `${y}px`;
		});

		const endDrag = () => {
			if (!drag) return;
			const moved = drag.moved;
			drag = null;
			container.classList.remove("mascot-dragging");
			if (!moved) {
				menuOpen ? closeMenu() : openMenu();
			}
		};
		img.addEventListener("pointerup", endDrag);
		img.addEventListener("pointercancel", () => {
			drag = null;
			container.classList.remove("mascot-dragging");
		});

		window.addEventListener("resize", fitCanvas);
		fitCanvas();

		// 初始化形象索引与随机切换定时器
		const initialIndex = images.indexOf(img.src);
		currentIndex = initialIndex >= 0 ? initialIndex : 0;
		startRandomTimer();
	}

	initMascot();
</script>
