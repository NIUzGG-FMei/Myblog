{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mfwblog-images",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "img.2298321.xyz",
      "custom_domain": true
    }
  ]
}
